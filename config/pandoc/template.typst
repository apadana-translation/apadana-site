$-- Pandoc Typst template for the PDF editions (poem, chapter, and full-set
$-- jobs in config/pandoc/). Replicates the layout of the former xelatex
$-- setup: cover page, title page, copyright page (include-before-body),
$-- then the text with alternating running heads.

$-- pandoc's typst writer emits #horizontalrule for thematic breaks
#let horizontalrule = line(start: (25%, 0%), end: (75%, 0%))

#show terms.item: it => block(breakable: false)[
  #text(weight: "bold")[#it.term]
  #block(inset: (left: 1.5em, top: -0.4em))[#it.description]
]

$if(smart)$
$else$
#set smartquote(enabled: false)
$endif$

$-- Text block sized to match the old 12pt LaTeX article on US letter
$-- (textwidth ~5.4in, hcentering, bindingoffset .2in, tmargin 1.2in,
$-- bmargin 1in). Inside/outside resolve against the page counter, which
$-- is reset after the cover so the title page is a recto numbered 1.
#let book-margin = (inside: 1.75in, outside: 1.55in, top: 1.2in, bottom: 1in)

$-- Alternating running heads, as in the old fancyhdr setup: verso pages
$-- carry the page number and the book title, recto pages the current poem
$-- (level-1 heading) and the page number. Front-matter pages (no heading
$-- seen yet) and poem-opening pages get no head.
#let book-header = context {
  let poems = query(heading.where(level: 1).before(here()))
  if poems.len() == 0 { return }
  let n = counter(page).get().first()
  set text(size: 10pt)
  if calc.even(n) [
    #smallcaps[#n #h(1.5em) Legends of the Buddhist Saints]
  ] else [
    #h(1fr) #smallcaps[#poems.last().body #h(1.5em) #n]
  ]
}

#set document(
  title: [$title$]$if(author)$,
  author: ($for(author)$"$author$",$endfor$)$endif$,
)

#set text($if(mainfont)$font: "$mainfont$", $endif$size: $if(fontsize)$$fontsize$$else$12pt$endif$, lang: "$if(lang)$$lang$$else$en$endif$")
#set par(justify: true)

$for(header-includes)$
$header-includes$

$endfor$
$if(cover-image)$
#set page(paper: "us-letter", margin: 0pt)
#image("$cover-image$", width: 100%, height: 100%, fit: "cover")
#set page(paper: "us-letter", binding: left, margin: book-margin, header: book-header)
#counter(page).update(1)
$else$
#set page(paper: "us-letter", binding: left, margin: book-margin, header: book-header)
$endif$

$if(title)$
#align(center)[
  #v(1em)
  #text(size: 1.5em)[$title$]
  $if(author)$
  #v(1.5em)
  #text(size: 1.15em)[$for(author)$$author$$sep$, $endfor$]
  $endif$
]
$endif$

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
#outline(depth: $toc-depth$)

$endif$
$body$
$for(include-after)$

$include-after$
$endfor$
